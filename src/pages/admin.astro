---
import knowledgeCategories from '../data/knowledge-categories.js';

// The local CMS is intentionally available only from Astro's dev server.
const isDev = import.meta.env.DEV;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{isDev ? <>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <title>猫猫手册后台</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { min-width: 320px; background: #f7f3ee; }
    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background: #f7f3ee;
      color: #2b241d;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
    }
    button, input, select, textarea { font: inherit; }

    .admin {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      gap: 6px;
      max-width: 1600px;
      height: 100vh;
      min-height: 720px;
      margin: auto;
      padding: 9px 16px 16px;
    }
    .topbar,
    .panel {
      border: 1px solid #e7e0d7;
      background: rgba(255, 255, 255, .95);
      box-shadow: 0 3px 12px rgba(96, 72, 45, .06);
    }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      min-height: 58px;
      padding: 9px 16px;
      border-radius: 9px;
    }
    .brand-group,
    .brand-lockup,
    .topbar-actions,
    .editor-actions,
    .status-group,
    .toolbar,
    .actions,
    .search-wrap,
    .editor-label,
    .panel-heading,
    .article-meta,
    .field-label {
      display: flex;
      align-items: center;
    }
    .brand-group { gap: 16px; min-width: 0; }
    .brand-lockup { gap: 13px; min-width: 0; }
    .brand-mark {
      display: grid;
      width: 34px;
      height: 34px;
      flex: 0 0 auto;
      place-items: center;
      color: #a26136;
    }
    .brand-mark svg { width: 30px; height: 30px; fill: currentColor; }
    .brand-title {
      margin: 0;
      overflow: hidden;
      color: #a26136;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -.035em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .environment {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 10px;
      border: 1px solid #e3d3c3;
      border-radius: 7px;
      color: #96543a;
      background: #fdf9f4;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .environment::before {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #c97940;
      content: "";
    }
    .topbar-actions { gap: 10px; }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 12px;
      border: 1px solid #e2d8cb;
      border-radius: 8px;
      color: #3d332b;
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .back-link:hover { border-color: #a26136; color: #8b4f2c; background: #fdf9f4; }

    .workspace {
      display: grid;
      grid-template-columns: minmax(300px, 356px) minmax(0, 1fr);
      gap: 6px;
      min-height: 0;
    }
    .panel { min-width: 0; border-radius: 9px; }
    .sidebar-panel {
      display: grid;
      grid-template-rows: auto auto auto minmax(0, 1fr);
      min-height: 0;
      padding: 20px 14px 11px;
    }
    .panel-heading {
      justify-content: space-between;
      margin: 0 0 15px;
      padding: 0;
    }
    .panel-heading h2,
    .editor-heading h2 {
      margin: 0;
      color: #2f2924;
      font-weight: 800;
      letter-spacing: -.025em;
    }
    .panel-heading h2 { font-size: 19px; }
    .count {
      color: #a39689;
      font-size: 11px;
      font-weight: 600;
    }
    .search-wrap { position: relative; margin-bottom: 10px; }
    .search-wrap svg { position: absolute; left: 11px; width: 16px; height: 16px; color: #8a7d70; pointer-events: none; }
    .search-wrap .search-icon-right { right: 10px; left: auto; }
    .search-wrap input { padding-right: 34px; padding-left: 34px; }
    .library-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 6px; margin-bottom: 10px; }
    .library-controls .search-wrap { min-width: 0; margin-bottom: 0; }
    .library-actions { display: flex; gap: 6px; }
    .library-action-wrap { position: relative; }
    .library-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 36px;
      padding: 0 8px;
      color: #5f5348;
      font-size: 11px;
      white-space: nowrap;
    }
    .library-action svg { width: 14px; height: 14px; flex: 0 0 auto; }
    .library-action.active { border-color: #d8a474; color: #8b4f2c; background: #f9efe4; }
    .library-action[aria-expanded="true"] { border-color: #d8a474; color: #8b4f2c; background: #f9efe4; }
    .control-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 16px;
      height: 16px;
      padding: 0 4px;
      border-radius: 999px;
      color: #fff;
      background: #a26136;
      font-size: 10px;
      line-height: 1;
    }
    .library-popover {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      z-index: 8;
      width: 190px;
      padding: 10px;
      border: 1px solid #e7e0d7;
      border-radius: 9px;
      background: #fff;
      box-shadow: 0 8px 22px rgba(96, 72, 45, .14);
    }
    .library-popover[hidden] { display: none; }
    .library-popover-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; color: #2f2924; font-size: 12px; }
    .library-popover-heading button { padding: 0; border: 0; color: #8b4f2c; background: transparent; font-size: 11px; font-weight: 600; }
    .library-popover-heading button:hover { border: 0; background: transparent; text-decoration: underline; }
    .sort-options { display: grid; gap: 4px; }
    .sort-option { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 32px; padding: 0 8px; border: 1px solid transparent; border-radius: 6px; color: #3d332b; background: transparent; font-size: 11px; text-align: left; }
    .sort-option small { color: #a39689; font-size: 10px; font-weight: 600; }
    .sort-option:hover { border-color: #e3c9a9; color: #8b4f2c; background: #fdf9f4; }
    .sort-option.on { color: #8b4f2c; background: #f9efe4; }
    .filter-fields { display: grid; gap: 8px; }
    .filter-field { display: grid; gap: 4px; color: #6f6257; font-size: 10px; font-weight: 700; }
    .filter-field select { min-height: 32px; padding: 5px 8px; font-size: 11px; }
    .filter-backdrop {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: rgba(43, 33, 23, .2);
      backdrop-filter: blur(2px);
    }
    .filter-modal {
      position: fixed;
      top: 50%;
      left: 50%;
      z-index: 21;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      width: min(92vw, 440px);
      max-height: min(92vh, 640px);
      overflow: visible;
      transform: translate(-50%, -50%);
      border: 1px solid #e7e0d7;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 18px 50px rgba(50, 38, 26, .2);
    }
    .filter-modal[hidden], .filter-backdrop[hidden] { display: none; }
    .filter-modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 20px 22px 16px; border-bottom: 1px solid #efe7dc; }
    .filter-modal-header h3 { margin: 0; color: #2f2924; font-size: 17px; letter-spacing: -.02em; }
    .filter-modal-header p { margin: 5px 0 0; color: #94887c; font-size: 11px; line-height: 1.5; }
    .filter-modal-close { display: grid; width: 28px; height: 28px; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #8a7d70; background: transparent; font-size: 20px; line-height: 1; }
    .filter-modal-close:hover { border: 0; color: #8b4f2c; background: #f9efe4; }
    .filter-modal-body { overflow: visible; padding: 18px 22px 20px; }
    .filter-modal-body .filter-fields { gap: 14px; }
    .filter-modal-body .filter-field { gap: 6px; color: #3d332b; font-size: 11px; }
    .custom-select { position: relative; align-self: start; width: 100%; min-width: 0; }
    .field-label > .custom-select { align-self: stretch; width: 100%; min-width: 0; }
    .custom-select-native { position: absolute; width: 1px; height: 1px; min-height: 0 !important; padding: 0 !important; border: 0 !important; opacity: 0; pointer-events: none; }
    .custom-select-trigger {
      display: flex; width: 100%; height: 36px; min-height: 36px;
      align-items: center; justify-content: space-between; gap: 8px;
      padding: 7px 9px; border: 1px solid #ded2c4; border-radius: 7px;
      color: #3d332b; background: #fffdfa; font-size: 12px; font-weight: 600; text-align: left;
    }
    .custom-select-trigger:hover { border-color: #cf9568; color: #8b4f2c; background: #fff; }
    .custom-select-trigger:disabled { border-color: #e8e0d5; color: #a89c8e; background: #f7f4ef; cursor: not-allowed; }
    .custom-select-trigger svg { width: 15px; height: 15px; flex: 0 0 auto; color: #a39689; transition: transform .15s ease, color .15s ease; }
    .custom-select.open .custom-select-trigger { border-color: #cf9568; box-shadow: inset 0 0 0 1px #cf9568; }
    .custom-select.open .custom-select-trigger svg { color: #a26136; transform: rotate(180deg); }
    .custom-select-menu {
      position: absolute; top: calc(100% + 5px); right: 0; left: 0; z-index: 30;
      max-height: 220px; overflow-y: auto; padding: 5px;
      border: 1px solid #e6d9c9; border-radius: 8px; background: #fffdfa;
      box-shadow: 0 12px 26px rgba(96, 72, 45, .14);
    }
    .custom-select-menu[hidden] { display: none; }
    .custom-select-option {
      display: flex; width: 100%; min-height: 32px; align-items: center;
      padding: 0 8px; border: 0; border-radius: 6px;
      color: #5f5348; background: transparent; font-size: 11px; font-weight: 600; text-align: left;
    }
    .custom-select-option::before { width: 16px; flex: 0 0 16px; color: #a26136; content: ""; font-size: 13px; font-weight: 800; }
    .custom-select-option:hover, .custom-select-option.is-selected { border: 0; color: #8b4f2c; background: #f7ede0; }
    .custom-select-option.is-selected::before { content: "✓"; }
    .filter-modal-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 22px; border-top: 1px solid #efe7dc; background: #fffdfa; }
    .filter-modal-footer .filter-clear-button { padding: 0; border: 0; color: #6f6257; background: transparent; font-size: 12px; font-weight: 600; }
    .filter-modal-footer .filter-clear-button:hover { border: 0; color: #8b4f2c; background: transparent; text-decoration: underline; }
    .filter-modal-footer .filter-done-button { min-height: 36px; padding: 0 16px; border-color: #a26136; color: #fff; background: #a26136; }
    .filter-modal-footer .filter-done-button:hover { border-color: #8b4f2c; color: #fff; background: #8b4f2c; }
    .toolbar { gap: 8px; margin-bottom: 16px; }
    .toolbar button:first-child { flex: 1 1 auto; }

    button {
      cursor: pointer;
      border: 1px solid #ded2c4;
      border-radius: 8px;
      color: #3d332b;
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      transition: border-color .15s, background .15s, color .15s, box-shadow .15s, opacity .15s;
    }
    button:hover { border-color: #a26136; color: #8b4f2c; background: #fdf9f4; }
    button:focus-visible { outline: 3px solid rgba(162, 97, 54, .16); outline-offset: 1px; }
    input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }
    button:disabled { cursor: wait; opacity: .65; }
    button.primary {
      min-height: 40px;
      padding: 0 16px;
      border-color: #a26136;
      color: #fff;
      background: #a26136;
      box-shadow: 0 5px 12px rgba(162, 97, 54, .16);
    }
    button.primary:hover { border-color: #8b4f2c; color: #fff; background: #8b4f2c; }
    .delete-button { min-height: 40px; padding: 0 15px; border-color: #e7b7b2; color: #b42318; background: #fff; white-space: nowrap; }
    .delete-button:hover { border-color: #d88b82; color: #9f1d1d; background: #fff5f5; }
    .delete-button:disabled { border-color: #ece7e3; color: #b8b2ad; background: #faf9f7; }
    .toolbar button { min-height: 38px; padding: 0 12px; }
    .toolbar button:first-child { color: #fff; border-color: #a26136; background: #a26136; }
    .toolbar button:first-child:hover { border-color: #8b4f2c; background: #8b4f2c; }
    .toolbar svg { vertical-align: -3px; margin-right: 5px; }
    input:not([type="checkbox"]), select, textarea {
      width: 100%;
      border: 1px solid #ded2c4;
      border-radius: 8px;
      color: #2b241d;
      background: #fff;
    }
    input, select { min-height: 36px; padding: 7px 10px; }
    textarea { resize: vertical; padding: 9px 10px; line-height: 1.55; }
    input[type="checkbox"] { width: auto; min-width: 0; accent-color: #a26136; }
    input:not([type="checkbox"]):focus, select:focus, textarea:focus { border-color: #c98a5b; box-shadow: inset 0 0 0 1px #c98a5b; outline: none; }
    .article-list {
      min-height: 0;
      overflow: auto;
      margin: 0 -5px;
      padding: 0 5px 4px;
      scrollbar-color: #c7bba9 transparent;
      scrollbar-width: thin;
    }
    .article-list::-webkit-scrollbar { width: 8px; }
    .article-list::-webkit-scrollbar-thumb { border: 2px solid transparent; border-radius: 999px; background: #c7bba9; background-clip: padding-box; }
    .article {
      display: block;
      width: 100%;
      margin: 0 0 6px;
      padding: 12px 12px 11px;
      text-align: left;
      border-color: #efe7dc;
      border-radius: 7px;
    }
    .article:hover { border-color: #e3c9a9; background: #fdf9f4; }
    .article.active {
      position: relative;
      border-color: #d8a474;
      background: #f9efe4;
      box-shadow: inset 3px 0 #a26136;
    }
    .article strong,
    .article small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .article strong { color: #2b241d; font-size: 13px; }
    .article small { margin-top: 5px; color: #6f6257; font-size: 11px; font-weight: 500; }
    .article-meta { gap: 7px; margin-top: 7px; overflow: hidden; color: #94887c; font-size: 11px; white-space: nowrap; }
    .article-meta span { overflow: hidden; text-overflow: ellipsis; }
    .article-meta span + span::before { margin-right: 7px; color: #c4b7a8; content: "·"; }
    .draft-badge {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      padding: 1px 7px;
      border: 1px solid #d8a474;
      border-radius: 999px;
      color: #96543a;
      background: #f9efe4;
      font-size: 10px;
      font-weight: 700;
    }
    .draft-badge::before { margin-right: 4px; color: #c97940; content: "•"; font-size: 12px; line-height: 1; }

    .main-panel {
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr);
      min-height: 0;
      padding: 20px 14px 12px;
    }
    .editor-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 20px; margin: 0 0 17px; padding: 0 2px; }
    .editor-heading > div:first-child { flex: 1 1 260px; min-width: 0; }
    .editor-heading h2 { font-size: 20px; }
    .editor-heading p { margin: 5px 0 0; color: #94887c; font-size: 12px; }
    .editor-actions { flex: 0 1 auto; flex-wrap: wrap; justify-content: flex-end; gap: 8px 14px; min-width: 0; max-width: 100%; }
    .status-group { flex: 0 1 auto; gap: 9px; min-width: 0; max-width: 100%; color: #8a7d70; font-size: 12px; white-space: nowrap; }
    .save-state { display: inline-flex; align-items: center; gap: 6px; }
    .save-state::before { width: 10px; height: 10px; border: 1.5px solid currentColor; border-radius: 50%; content: ""; }
    .save-state.saved { color: #15803d; font-weight: 700; }
    .save-state.saved::before { border-width: 2px; }
    .save-state.saving { color: #b45309; }
    .save-state.error { color: #b42318; white-space: normal; overflow-wrap: anywhere; }
    .save-state.neutral { color: #8a7d70; }

    .fields { min-height: 0; margin-bottom: 12px; }
    .field-grid { display: grid; gap: 10px; }
    .field-card-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1fr) minmax(0, 1fr); }
    .field-card {
      min-width: 0;
      padding: 14px;
      border: 1px solid #efe7dc;
      border-radius: 8px;
      background: #fffdfa;
    }
    .field-card-heading { margin-bottom: 13px; }
    .field-card-heading h3 { margin: 0; color: #2f2924; font-size: 14px; }
    .field-card-heading p { margin: 4px 0 0; color: #a39689; font-size: 11px; line-height: 1.45; }
    .field-stack { display: grid; min-width: 0; gap: 10px; }
    .field-row { display: grid; min-width: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .field-label { align-items: flex-start; flex-direction: column; gap: 5px; width: 100%; min-width: 0; color: #3d332b; font-size: 11px; font-weight: 700; }
    .field-label-caption { display: inline-flex; align-items: center; gap: 3px; min-height: 14px; }
    .field-label > input,
    .field-label > select,
    .field-label > textarea { display: block; width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
    .field-label-check { flex-direction: row; align-items: center; gap: 7px; }
    .field-label-check input[type="checkbox"] { width: 15px; height: 15px; margin: 0; }
    .required { color: #a26136; }
    .metadata-description { min-height: 74px; }
    .editor-workspace { --editor-content-gap: 28px; --editor-caret-space: 10.5em; position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; border: 1px solid #efe7dc; border-radius: 8px; overflow: hidden; }
    .editor-sync-controls { position: absolute; top: 50%; left: 50%; z-index: 3; display: grid; gap: 3px; transform: translate(-50%, -50%); padding: 4px; border: 1px solid #e7e0d7; border-radius: 999px; background: #fff; box-shadow: 0 4px 12px rgba(96, 72, 45, .12); }
    .editor-sync-button { display: grid; width: 25px; height: 25px; min-width: 25px; place-items: center; padding: 0; border: 0; border-radius: 50%; color: #6f6257; background: transparent; font-size: 16px; line-height: 1; }
    .editor-sync-button:hover { border: 0; color: #a26136; background: #f7ede0; }
    .editor-sync-button:focus-visible { outline: 2px solid rgba(162, 97, 54, .28); outline-offset: 1px; }
    .editor-column { display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; min-width: 0; min-height: 0; }
    .editor-column:last-child { grid-template-rows: auto minmax(0, 1fr); }
    .editor-column + .editor-column { border-left: 1px solid #efe7dc; }
    .editor-label { min-height: 42px; justify-content: space-between; padding: 0 13px; border-bottom: 1px solid #efe7dc; color: #2f2924; font-size: 13px; font-weight: 800; }
    .editor-label span { color: #94887c; font-size: 11px; font-weight: 600; }
    .editor-toolbar { display: flex; align-items: center; gap: 2px; min-height: 37px; padding: 4px 8px; overflow-x: auto; border-bottom: 1px solid #efe7dc; background: #fffdfa; }
    .editor-tool { display: inline-grid; min-width: 27px; height: 27px; flex: 0 0 auto; place-items: center; padding: 0 5px; border: 0; border-radius: 5px; color: #54493e; background: transparent; font-size: 13px; font-weight: 700; }
    .editor-tool:hover { border: 0; color: #8b4f2c; background: #f7ede0; }
    .editor-tool-divider { width: 1px; height: 20px; flex: 0 0 auto; margin: 0 5px; background: #e6ddd1; }
    .editor-pane { position: relative; display: block; min-width: 0; min-height: 0; overflow: hidden; background: #fff; }
    textarea#body { display: block; width: 100%; max-width: 100%; min-width: 0; min-height: 0; height: 100%; resize: none; border: 0; border-radius: 0; padding: 15px var(--editor-content-gap) calc(15px + var(--editor-caret-space)) 15px; overflow-x: hidden; overflow-y: auto; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word; color: #3a2f26; font: 13px/1.75 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .editor-jump-controls { position: absolute; right: 12px; bottom: 12px; z-index: 2; display: grid; gap: 6px; }
    .editor-jump-button { display: grid; width: 30px; height: 30px; place-items: center; padding: 0; border: 1px solid rgba(127, 90, 55, .24); border-radius: 50%; color: rgba(139, 79, 44, .78); background: rgba(255, 253, 251, .8); box-shadow: 0 3px 10px rgba(96, 72, 45, .12); opacity: .58; transition: opacity .15s, color .15s, background-color .15s, transform .15s; }
    .editor-jump-button:hover, .editor-jump-button:focus-visible { color: #8b4f2c; background: rgba(249, 239, 228, .94); opacity: .96; }
    .editor-jump-button:focus-visible { outline: 2px solid rgba(162, 97, 54, .28); outline-offset: 2px; }
    .editor-jump-button:active { transform: scale(.94); }
    .editor-jump-button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
    .editor-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; padding: 0 12px; border-top: 1px solid #efe7dc; color: #8a7d70; font-size: 11px; }
