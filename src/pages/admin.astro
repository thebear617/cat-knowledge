  </div>
  <script define:vars={{ knowledgeCategories }}>
    const $ = (id) => document.getElementById(id);
    const KNOWLEDGE_CATEGORIES = knowledgeCategories;
    function articleFilenameFromTitle(value) {
      const normalized = String(value || '')
        .trim()
        .replaceAll('\0', '')
        .replaceAll('/', '／')
        .replaceAll('\\', '＼')
        .replace(/\.md$/i, '')
        .trim();
      return normalized && normalized !== '.' && normalized !== '..' ? `${normalized}.md` : null;
    }
    let articles = [];
    let selectedPath = '';
    let isDirty = false;
    let previewRequestId = 0;
    let editorState = null;
    let undoStack = [];
    let redoStack = [];
    let isProgrammaticEdit = false;
    let selectedPreviewNode = null;
    let selectedPreviewSourceRange = null;
    let deleteReturnFocus = null;
    let deletePromise = null;
    let pendingScrollRestore = null;
    let syncHighlightTimer = null;
    let sortKey = 'updated-desc';
    let autoSaveTimer = 0;
    let savePromise = null;
    let draftVersion = 0;
    const EDITOR_SESSION_KEY = 'cats-admin-editor-state-v1';
    const EDITOR_DRAFT_KEY = 'cats-admin-editor-draft-v1';
    const IMMERSIVE_SESSION_KEY = 'cats-admin-immersive-v1';
    const editorHistoryLimit = 100;
    const AUTO_SAVE_DELAY = 900;
    const fields = ['title', 'description', 'category', 'subcategory', 'publishedAt', 'updated', 'draft', 'slug'];
    const sortLabels = {
      'title-asc': '标题 A → Z',
      'title-desc': '标题 Z → A',
      'updated-desc': '最近更新',
      'date-desc': '发布日期',
    };
    const escapeHtml = (text) => String(text ?? '').replace(/[&<>"']/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const setStatus = (message, kind = 'neutral') => { $('status').textContent = message; $('status').className = `save-state ${kind}`; };
    function scheduleAutoSave() {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      if (!isDirty) return;
      autoSaveTimer = window.setTimeout(() => {
        autoSaveTimer = 0;
        void saveArticle();
      }, AUTO_SAVE_DELAY);
    }
    const markDirty = () => {
      isDirty = true;
      draftVersion += 1;
      setStatus('等待自动保存', 'saving');
      rememberEditorDraft();
      scheduleAutoSave();
    };
    function rememberEditorSession() {
      if (!selectedPath) return;
      const body = $('body');
      const snapshot = {
        selectedPath,
        selectionStart: body.selectionStart,
        selectionEnd: body.selectionEnd,
        scrollTop: body.scrollTop,
        previewScrollTop: $('preview').scrollTop,
        pageScrollTop: window.scrollY,
      };
      try { sessionStorage.setItem(EDITOR_SESSION_KEY, JSON.stringify(snapshot)); } catch { /* sessionStorage may be unavailable in a restricted browser context. */ }
    }

    function rememberEditorDraft() {
      if (!isDirty) return;
      const body = $('body');
      const path = editorArticlePath();
      if (!path) return;
      const snapshot = {
        version: 1,
        selectedPath: selectedPath || '',
        path,
        frontmatter: collectFrontmatter(),
        body: body.value,
        selectionStart: body.selectionStart,
        selectionEnd: body.selectionEnd,
        scrollTop: body.scrollTop,
        previewScrollTop: $('preview').scrollTop,
        pageScrollTop: window.scrollY,
      };
      try { localStorage.setItem(EDITOR_DRAFT_KEY, JSON.stringify(snapshot)); } catch { /* localStorage may be unavailable or full. */ }
    }

    function readEditorDraft() {
      try {
        const raw = localStorage.getItem(EDITOR_DRAFT_KEY);
        if (!raw) return null;
        const snapshot = JSON.parse(raw);
        return snapshot && typeof snapshot === 'object' && snapshot.version === 1 ? snapshot : null;
      } catch { return null; }
    }

    function clearEditorDraft() {
      try { localStorage.removeItem(EDITOR_DRAFT_KEY); } catch { /* localStorage may be unavailable. */ }
    }

    function restoreEditorDraft(snapshot) {
      if (!snapshot || typeof snapshot.body !== 'string') return false;
      const path = String(snapshot.path || '').trim();
      if (!path) return false;
      const existingPath = snapshot.selectedPath || path;
      if (snapshot.selectedPath && !articles.some((article) => article.path === existingPath || article.path === path)) return false;
      selectedPath = snapshot.selectedPath || '';
      fill({ body: snapshot.body, ...(snapshot.frontmatter || {}) });
      isDirty = true;
      renderList();
      setStatus('已恢复未保存草稿', 'saving');
      scheduleAutoSave();
      return true;
    }

    function readEditorSession() {
      try {
        const raw = sessionStorage.getItem(EDITOR_SESSION_KEY);
        if (!raw) return null;
        const snapshot = JSON.parse(raw);
        return snapshot && typeof snapshot === 'object' ? snapshot : null;
      } catch { return null; }
    }

    function readImmersiveSession() {
      try { return sessionStorage.getItem(IMMERSIVE_SESSION_KEY) === 'true'; } catch { return false; }
    }

    function setImmersiveMode(enabled, { focus = true, persist = true } = {}) {
      const button = $('immersive-toggle');
      document.body.classList.toggle('is-immersive', enabled);
      button.setAttribute('aria-pressed', String(enabled));
      button.textContent = enabled ? '退出沉浸式编辑' : '沉浸式编辑';
      button.setAttribute('aria-label', enabled ? '退出沉浸式编辑' : '进入沉浸式编辑');
      button.title = enabled ? '退出沉浸式编辑（Esc）' : '进入沉浸式编辑';
      if (persist) {
        try { sessionStorage.setItem(IMMERSIVE_SESSION_KEY, String(enabled)); } catch { /* sessionStorage may be unavailable. */ }
      }
      if (focus) (enabled ? $('body') : button).focus({ preventScroll: true });
    }

    function closeEscapeLayers() {
      if (!$('delete-modal').hidden) {
        if (!deletePromise) closeDeleteModal();
        return true;
      }
      const customSelect = document.querySelector('.custom-select.open');
      if (customSelect) {
        closeCustomSelects();
        return true;
      }
      if (!$('filter-menu').hidden) {
        closeFilterModal();
        return true;
      }
      if (!$('sort-menu').hidden) {
        closeLibraryMenus();
        return true;
      }
      return false;
    }

    function restoreEditorPosition(snapshot) {
      if (!snapshot) return;
      const body = $('body');
      const max = body.value.length;
      const start = Math.min(Math.max(Number(snapshot.selectionStart) || 0, 0), max);
      const end = Math.min(Math.max(Number(snapshot.selectionEnd) || start, start), max);
      body.focus({ preventScroll: true });
      body.setSelectionRange(start, end);
      body.scrollTop = Math.min(Math.max(Number(snapshot.scrollTop) || 0, 0), body.scrollHeight);
      if (snapshot.previewScrollTop != null || snapshot.pageScrollTop != null) {
        pendingScrollRestore = {
          previewTop: Math.max(Number(snapshot.previewScrollTop) || 0, 0),
          pageTop: Math.max(Number(snapshot.pageScrollTop) || 0, 0),
        };
      }
    }

    function restoreScrollPositions(previewTop, pageTop) {
      // Immersive mode scrolls inside #preview; normal mode grows with content and scrolls with the window, so compensate both owners.
      const preview = $('preview');
      let settled = false;
      const settle = () => {
        settled = true;
        window.removeEventListener('wheel', settle);
        window.removeEventListener('touchstart', settle);
      };
      const apply = () => {
        if (settled) return;
        preview.scrollTop = Math.min(previewTop, preview.scrollHeight);
        window.scrollTo(0, Math.min(pageTop, document.documentElement.scrollHeight));
      };
      window.addEventListener('wheel', settle, { passive: true });
      window.addEventListener('touchstart', settle, { passive: true });
      apply();
      window.setTimeout(settle, 3000);
    }

    function customSelectRoot(id) {
      return document.querySelector(`[data-custom-select="${id}"]`);
    }
    function closeCustomSelects(except = null) {
      document.querySelectorAll('.custom-select.open').forEach((root) => {
        if (root === except) return;
        root.classList.remove('open');
        root.querySelector('.custom-select-menu').hidden = true;
        root.querySelector('.custom-select-trigger').setAttribute('aria-expanded', 'false');
      });
    }
    function syncCustomSelect(id) {
      const select = $(id);
      const root = customSelectRoot(id);
      if (!select || !root) return;
      const trigger = root.querySelector('.custom-select-trigger');
      const label = root.querySelector('.custom-select-label');
      const menu = root.querySelector('.custom-select-menu');
      const selected = Array.from(select.options).find((option) => option.value === select.value) || select.options[0];
      label.textContent = selected?.textContent || '';
      trigger.disabled = select.disabled;
      if (select.disabled) {
        root.classList.remove('open');
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }
      menu.innerHTML = '';
      Array.from(select.options).forEach((option) => {
        const item = document.createElement('button');
        item.className = `custom-select-option${option.value === select.value ? ' is-selected' : ''}`;
        item.type = 'button';
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', String(option.value === select.value));
        item.textContent = option.textContent;
        item.onclick = (event) => {
          event.stopPropagation();
          if (select.disabled) return;
          select.value = option.value;
          syncCustomSelect(id);
          select.dispatchEvent(new Event('change', { bubbles: true }));
          closeCustomSelects();
        };
        menu.append(item);
      });
    }
    function initializeCustomSelects() {
      document.querySelectorAll('[data-custom-select]').forEach((root) => {
        const id = root.dataset.customSelect;
        const select = $(id);
        const trigger = root.querySelector('.custom-select-trigger');
        const menu = root.querySelector('.custom-select-menu');
        trigger.onclick = (event) => {
          event.stopPropagation();
          if (select.disabled) return;
          const shouldOpen = menu.hidden;
          closeCustomSelects(root);
          menu.hidden = !shouldOpen;
          root.classList.toggle('open', shouldOpen);
          trigger.setAttribute('aria-expanded', String(shouldOpen));
        };
        menu.onclick = (event) => event.stopPropagation();
        syncCustomSelect(id);
      });
    }
    function updateEditorMeta() {
      const body = $('body');
      const beforeCursor = body.value.slice(0, body.selectionStart);
      const lines = beforeCursor.split('\n');
      $('cursor-position').textContent = `行 ${lines.length}，列 ${lines.at(-1).length + 1}`;
      $('character-count').textContent = `${body.value.length} 字符`;
      if (editorState && !isProgrammaticEdit) editorState = getEditorState();
    }
    function getEditorState() {
      const body = $('body');
      return { value: body.value, selectionStart: body.selectionStart, selectionEnd: body.selectionEnd };
    }
    function sameEditorValue(left, right) {
      return left?.value === right?.value;
    }
    function pushUndo(state) {
      if (!state || sameEditorValue(undoStack.at(-1), state)) return;
      undoStack.push(state);
      if (undoStack.length > editorHistoryLimit) undoStack.shift();
      redoStack = [];
    }
    function resetEditorHistory() {
      editorState = getEditorState();
      undoStack = [];
      redoStack = [];
    }
    function runEditorEdit(edit) {
      const previous = editorState || getEditorState();
      isProgrammaticEdit = true;
      try {
        edit();
      } finally {
        isProgrammaticEdit = false;
      }
      const next = getEditorState();
      if (!sameEditorValue(previous, next)) pushUndo(previous);
      editorState = next;
      handleBodyChange();
    }
    function restoreEditorState(state) {
      const body = $('body');
      isProgrammaticEdit = true;
      body.value = state.value;
      body.focus();
      const max = body.value.length;
      body.setSelectionRange(Math.min(state.selectionStart, max), Math.min(state.selectionEnd, max));
      isProgrammaticEdit = false;
      editorState = getEditorState();
      handleBodyChange();
    }
    function undoEditor() {
      if (!undoStack.length) return;
      const current = editorState || getEditorState();
      const previous = undoStack.pop();
      redoStack.push(current);
      restoreEditorState(previous);
    }
    function redoEditor() {
      if (!redoStack.length) return;
      const current = editorState || getEditorState();
      const next = redoStack.pop();
      undoStack.push(current);
      restoreEditorState(next);
    }
    function handleHistoryShortcut(event) {
      const active = document.activeElement;
      const inMarkdownEditor = active === $('body') || active?.classList.contains('editor-tool');
      if (!inMarkdownEditor || (!event.metaKey && !event.ctrlKey) || event.altKey) return;
      const key = event.key.toLowerCase();
      const undo = key === 'z' && !event.shiftKey;
      const redo = (key === 'z' && event.shiftKey) || (key === 'y' && !event.shiftKey);
      if (!undo && !redo) return;
      event.preventDefault();
      if (undo) undoEditor();
      if (redo) redoEditor();
    }
    function indentBodySelection() {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const indent = '  ';
      if (start === end) {
        body.setRangeText(indent, start, end, 'end');
      } else {
        const value = body.value;
        const lineStart = value.lastIndexOf('\n', start - 1) + 1;
        const selectionEndsAtLineStart = value[end - 1] === '\n';
        const lineEnd = selectionEndsAtLineStart ? end : (value.indexOf('\n', end) === -1 ? value.length : value.indexOf('\n', end));
        const lines = value.slice(lineStart, lineEnd).split('\n');
        body.setRangeText(lines.map((line) => `${indent}${line}`).join('\n'), lineStart, lineEnd, 'select');
        body.setSelectionRange(start + indent.length, end + indent.length * lines.length);
      }
      body.dispatchEvent(new Event('input', { bubbles: true }));
    }

    function outdentBodySelection() {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const value = body.value;
      const lineStart = value.lastIndexOf('\n', start - 1) + 1;
      const selectionEndsAtLineStart = value[end - 1] === '\n';
      const lineEnd = selectionEndsAtLineStart ? end : (value.indexOf('\n', end) === -1 ? value.length : value.indexOf('\n', end));
      const lines = value.slice(lineStart, lineEnd).split('\n');
      const removed = lines.map((line) => (line.match(/^(?:\t| {1,2})/) || [''])[0].length);
      if (!removed.some((count) => count > 0)) return;
      body.setRangeText(lines.map((line) => line.replace(/^(?:\t| {1,2})/, '')).join('\n'), lineStart, lineEnd, 'select');
      const totalRemoved = removed.reduce((sum, count) => sum + count, 0);
      body.setSelectionRange(Math.max(lineStart, start - removed[0]), Math.max(lineStart, end - totalRemoved));
      body.dispatchEvent(new Event('input', { bubbles: true }));
    }
    function handleBodyKeydown(event) {
      if (event.key === 'Tab') {
        event.preventDefault();
        if (event.shiftKey) outdentBodySelection();
        else indentBodySelection();
        return;
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        event.stopPropagation();
        void saveArticle({ force: true });
      }
    }
    async function preview() {
      const requestId = ++previewRequestId;
      const source = $('body').value;
      if (!source.trim()) {
        $('preview').innerHTML = '';
        selectedPreviewNode = null;
        selectedPreviewSourceRange = null;
        pendingScrollRestore = null;
        $('preview').classList.remove('is-loading');
        return;
      }
      $('preview').classList.add('is-loading');
      try {
        const res = await fetch('/admin/api/preview', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ body: source }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '预览渲染失败');
        if (requestId === previewRequestId) {
          $('preview').innerHTML = data.html || '';
          selectedPreviewNode = null;
          selectedPreviewSourceRange = null;
          if (pendingScrollRestore) {
            const { previewTop, pageTop } = pendingScrollRestore;
            pendingScrollRestore = null;
            restoreScrollPositions(previewTop, pageTop);
          }
        }
      } catch (error) {
        if (requestId === previewRequestId) {
          $('preview').innerHTML = `<p class="preview-error">预览渲染失败：${escapeHtml(error.message)}</p>`;
          selectedPreviewNode = null;
          selectedPreviewSourceRange = null;
        }
      } finally {
        if (requestId === previewRequestId) $('preview').classList.remove('is-loading');
      }
    }
    const previewBlockSelector = 'h1[data-source-start], h2[data-source-start], h3[data-source-start], h4[data-source-start], h5[data-source-start], h6[data-source-start], p[data-source-start], ul[data-source-start], ol[data-source-start], blockquote[data-source-start]';
    function findPreviewBlock(node) {
      const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
      const block = element?.closest?.(previewBlockSelector);
      return block && $('preview').contains(block) ? block : null;
    }
    function sourceLineOffset(line, end = false) {
      const source = $('body').value;
      if (line <= 1) return end ? (source.indexOf('\n') === -1 ? source.length : source.indexOf('\n')) : 0;
      let offset = 0;
      for (let current = 1; current < line; current += 1) {
        const newline = source.indexOf('\n', offset);
        if (newline === -1) return source.length;
        offset = newline + 1;
      }
      if (!end) return offset;
      const newline = source.indexOf('\n', offset);
      return newline === -1 ? source.length : newline;
    }
    function previewRange(node) {
      const startLine = Number(node?.dataset.sourceStart);
      const endLine = Number(node?.dataset.sourceEnd);
      if (!startLine || !endLine) return null;
      return { start: sourceLineOffset(startLine), end: sourceLineOffset(endLine, true), startLine, endLine };
    }
    function capturePreviewSelection() {
      const preview = $('preview');
      const selection = window.getSelection();
      if (!selection?.rangeCount || selection.isCollapsed || !preview.contains(selection.anchorNode) || !preview.contains(selection.focusNode)) return;
      const nodes = [findPreviewBlock(selection.anchorNode), findPreviewBlock(selection.focusNode)].filter(Boolean);
      const ranges = nodes.map(previewRange).filter(Boolean);
      if (!ranges.length) return;
      selectedPreviewNode = nodes[0];
      selectedPreviewSourceRange = {
        start: Math.min(...ranges.map(range => range.start)),
        end: Math.max(...ranges.map(range => range.end)),
        startLine: Math.min(...ranges.map(range => range.startLine)),
        endLine: Math.max(...ranges.map(range => range.endLine)),
      };
    }
    function previewBlocks() {
      return Array.from($('preview').querySelectorAll(previewBlockSelector));
    }
    function previewBlockPosition(node) {
      const preview = $('preview');
      const previewRect = preview.getBoundingClientRect();
      const rect = node.getBoundingClientRect();
      return {
        top: rect.top - previewRect.top + preview.scrollTop,
        bottom: rect.bottom - previewRect.top + preview.scrollTop,
      };
    }
    function findPreviewBlockForScrollPosition() {
      const preview = $('preview');
      const targetPosition = preview.scrollTop + Math.min(72, preview.clientHeight * 0.32);
      const candidates = previewBlocks()
        .map(node => ({ node, range: previewRange(node), position: previewBlockPosition(node) }))
        .filter(item => item.range);
      const containing = candidates
        .filter(item => item.position.top <= targetPosition && item.position.bottom >= targetPosition)
        .sort((left, right) => {
          const lineSpan = item => item.range.endLine - item.range.startLine;
          return lineSpan(left) - lineSpan(right);
        });
      if (containing[0]) return containing[0].node;
      return candidates
        .sort((left, right) => Math.abs(left.position.top - targetPosition) - Math.abs(right.position.top - targetPosition))[0]?.node || null;
    }
    function findPreviewBlockForLine(line) {
      const blocks = previewBlocks();
      const containing = blocks
        .filter(node => {
          const range = previewRange(node);
          return range && range.startLine <= line && range.endLine >= line;
        })
        .sort((left, right) => {
          const leftRange = previewRange(left);
          const rightRange = previewRange(right);
          return (leftRange.endLine - leftRange.startLine) - (rightRange.endLine - rightRange.startLine);
        });
      if (containing[0]) return containing[0];
      return blocks
        .map(node => ({ node, range: previewRange(node) }))
        .filter(item => item.range)
        .sort((left, right) => Math.abs(left.range.startLine - line) - Math.abs(right.range.startLine - line))[0]?.node || null;
    }
    function highlightPreviewBlock(node) {
      if (!node) return;
      $('preview').querySelectorAll('.is-sync-target').forEach(target => target.classList.remove('is-sync-target'));
      node.classList.add('is-sync-target');
      selectedPreviewNode = node;
      node.scrollIntoView({ behavior: 'smooth', block: 'center' });
      window.clearTimeout(syncHighlightTimer);
      syncHighlightTimer = window.setTimeout(() => node.classList.remove('is-sync-target'), 1400);
    }
    function syncSourceToPreview() {
      const source = $('body').value;
      const line = source.slice(0, $('body').selectionStart).split('\n').length;
      const target = findPreviewBlockForLine(line);
      if (!target) return setStatus('当前内容没有可定位的预览区域', 'neutral');
      highlightPreviewBlock(target);
    }
    function syncPreviewToSource() {
      const selection = window.getSelection();
      const selectionNode = selection?.rangeCount
        ? [selection.anchorNode, selection.focusNode]
          .filter(node => $('preview').contains(node))
          .map(findPreviewBlock)
          .find(Boolean)
        : null;
      const target = [selectionNode, selectedPreviewNode, findPreviewBlockForScrollPosition()]
        .find(node => previewRange(node));
      const range = selectionNode ? previewRange(selectionNode) : (selectedPreviewSourceRange || previewRange(target));
      if (!target || !range) return setStatus('当前预览没有可定位的内容', 'neutral');
      const body = $('body');
      body.focus();
      body.setSelectionRange(range.start, range.end);
      const lineHeight = Number.parseFloat(getComputedStyle(body).lineHeight) || 22;
      body.scrollTop = Math.max(0, (range.startLine - 1) * lineHeight - body.clientHeight / 2);
      updateEditorMeta();
    }

    function refreshEditorSubcategories(selectedValue) {
      const category = $('category').value;
      const subcategorySelect = $('subcategory');
      const subcategories = KNOWLEDGE_CATEGORIES[category] || [];
      subcategorySelect.innerHTML = '';
      if (subcategories.length) {
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '请选择二级主题';
        subcategorySelect.append(placeholder);
        subcategories.forEach((sub) => {
          const option = document.createElement('option');
          option.value = sub;
          option.textContent = sub;
          subcategorySelect.append(option);
        });
        subcategorySelect.disabled = false;
      } else {
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '请先选择一级分类';
        subcategorySelect.append(placeholder);
        subcategorySelect.disabled = true;
      }
      if (selectedValue && Array.from(subcategorySelect.options).some((option) => option.value === selectedValue)) {
        subcategorySelect.value = selectedValue;
      } else {
        subcategorySelect.value = '';
      }
      syncCustomSelect('subcategory');
    }

    function collectFrontmatter() {
      return {
        title: $('title').value,
        description: $('description').value,
        category: $('category').value,
        subcategory: $('subcategory').value,
        publishedAt: $('publishedAt').value,
        updated: $('updated').value,
        slug: $('slug').value,
        draft: $('draft').checked,
      };
    }

    function updateFileLabel() {
      $('file-label').textContent = '文件路径（由标题自动生成）';
      $('folder-path').value = editorArticlePath();
    }

    function editorArticlePath() {
      return articleFilenameFromTitle($('title').value) || '';
    }

    function fill(item = {}) {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      draftVersion += 1;
      const categorySelect = $('category');
      if (item.category && Array.from(categorySelect.options).some((option) => option.value === item.category)) {
        categorySelect.value = item.category;
      } else {
        categorySelect.selectedIndex = 0;
      }
      syncCustomSelect('category');
      refreshEditorSubcategories(item.subcategory);
      fields.forEach((field) => {
        if (field === 'category' || field === 'subcategory') return;
        const element = $(field);
        if (!element) return;
        if (field === 'draft') {
          element.checked = item.draft === true;
          return;
        }
        element.value = item[field] ?? '';
      });
      updateFileLabel();
      $('body').value = item.body || '';
      resetEditorHistory();
      preview();
      isDirty = false;
      updateEditorMeta();
      updateDeleteButton();
    }

    function updateDeleteButton() {
      const button = $('delete');
      if (!button) return;
      const canDelete = Boolean(selectedPath);
      button.disabled = !canDelete || Boolean(deletePromise);
      button.title = canDelete ? '将当前文章移入废纸篓' : '新文章尚未保存';
    }

    function setDeleteModalBusy(busy) {
      $('delete-modal-confirm').disabled = busy;
      $('delete-modal-cancel').disabled = busy;
      $('delete-modal-close').disabled = busy;
      $('delete-modal-confirm').textContent = busy ? '删除中…' : '删除';
    }

    function openDeleteModal() {
      if (!selectedPath || deletePromise) return;
      const title = $('title').value.trim() || selectedPath;
      $('delete-modal-message').textContent = `确定要将“${title}”移入废纸篓吗？Markdown 文件仍可从废纸篓恢复。`;
      deleteReturnFocus = document.activeElement;
      $('delete-modal').hidden = false;
      $('delete-modal').setAttribute('aria-hidden', 'false');
      window.requestAnimationFrame(() => $('delete-modal-cancel').focus());
    }

    function closeDeleteModal({ restoreFocus = true } = {}) {
      const modal = $('delete-modal');
      if (modal.hidden) return;
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      const returnFocus = deleteReturnFocus;
      deleteReturnFocus = null;
      if (restoreFocus && returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus({ preventScroll: true });
    }

    async function deleteCurrentArticle() {
      if (!selectedPath || deletePromise) return false;
      setDeleteModalBusy(true);
      const promise = (async () => {
        try {
          if (isDirty && !(await flushAutoSave())) {
            setStatus('自动保存失败，未删除', 'error');
            return false;
          }
          const articlePath = selectedPath;
          if (!articlePath) return false;
          const res = await fetch('/admin/api/article?path=' + encodeURIComponent(articlePath), { method: 'DELETE' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || '删除失败');
          selectedPath = '';
          isDirty = false;
          try { await loadList(); } catch { /* The file is already in the Trash even if the list refresh fails. */ }
          fill();
          setStatus('已移入废纸篓', 'saved');
          closeDeleteModal({ restoreFocus: false });
          $('title').focus();
          return true;
        } catch (error) {
          setStatus(error.message, 'error');
          return false;
        } finally {
          setDeleteModalBusy(false);
        }
      })();
      deletePromise = promise;
      try { return await promise; }
      finally {
        if (deletePromise === promise) {
          deletePromise = null;
          updateDeleteButton();
        }
      }
    }
    function replaceSelection(before, after = '', placeholder = '') {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const selected = body.value.slice(start, end) || placeholder;
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(before + selected + after, start, end, 'select');
      });
    }
    function isWrapped(value, before, after) {
      if (value.length < before.length + after.length || !value.startsWith(before) || !value.endsWith(after)) return false;
      if (before === '*' && after === '*' && (value.startsWith('**') || value.endsWith('**'))) return false;
      return true;
    }
    function toggleWrap(before, after, placeholder = '') {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const value = body.value;
      const selected = value.slice(start, end);
      const wrappedInside = isWrapped(selected, before, after);
      const wrappedAround = start >= before.length
        && value.slice(start - before.length, start) === before
        && value.slice(end, end + after.length) === after;
      let rangeStart = start;
      let rangeEnd = end;
      let replacement = selected || placeholder;
      let selectionStart = start;
      let selectionEnd = start + replacement.length;

      if (wrappedInside) {
        replacement = selected.slice(before.length, selected.length - after.length);
        selectionEnd = start + replacement.length;
      } else if (wrappedAround) {
        rangeStart = start - before.length;
        rangeEnd = end + after.length;
        selectionStart = rangeStart;
        selectionEnd = rangeStart + selected.length;
      } else {
        replacement = before + replacement + after;
        selectionEnd = start + replacement.length;
      }

      runEditorEdit(() => {
        body.focus();
        body.setRangeText(replacement, rangeStart, rangeEnd, 'end');
        body.setSelectionRange(selectionStart, selectionEnd);
      });
    }
    function prefixLines(prefix, numbered = false) {
      const body = $('body');
      const start = body.selectionStart;
      const end = body.selectionEnd;
      const lineStart = body.value.lastIndexOf('\n', Math.max(0, start - 1)) + 1;
      const nextLine = body.value.indexOf('\n', end);
      const lineEnd = nextLine === -1 ? body.value.length : nextLine;
      const selected = body.value.slice(lineStart, lineEnd);
      const lines = selected.split('\n').map((line, index) => `${numbered ? `${index + 1}. ` : prefix}${line}`);
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(lines.join('\n'), lineStart, lineEnd, 'select');
      });
    }
    function insertTemplate(template) {
      const body = $('body');
      runEditorEdit(() => {
        body.focus();
        body.setRangeText(template, body.selectionStart, body.selectionEnd, 'end');
      });
    }
    function applyToolbarAction(action) {
      if (action === 'bold') toggleWrap('**', '**', '加粗文字');
      if (action === 'italic') toggleWrap('*', '*', '斜体文字');
      if (action === 'h1') prefixLines('# ');
      if (action === 'h2') prefixLines('## ');
      if (action === 'h3') prefixLines('### ');
      if (action === 'bullet') prefixLines('- ');
      if (action === 'numbered') prefixLines('', true);
      if (action === 'quote') prefixLines('> ');
      if (action === 'code') toggleWrap('`', '`', '代码');
      if (action === 'link') replaceSelection('[', '](https://example.com)', '链接文字');
      if (action === 'table') insertTemplate('| 项目 | 说明 |\n| --- | --- |\n| 内容 | 示例 |');
    }
    function handleBodyChange() {
      preview();
      updateEditorMeta();
      markDirty();
    }
    function handleBodyInput() {
      if (isProgrammaticEdit) return;
      const next = getEditorState();
      if (!sameEditorValue(editorState, next)) pushUndo(editorState);
      editorState = next;
      handleBodyChange();
    }
    function compareText(left, right) {
      return String(left || '').localeCompare(String(right || ''), 'zh-CN');
    }
    function compareDate(left, right) {
      return String(left || '').localeCompare(String(right || ''));
    }
    function compareArticles(left, right) {
      if (sortKey === 'title-desc') return compareText(right.title, left.title);
      if (sortKey === 'updated-desc') {
        return compareDate(right.updated || right.publishedAt, left.updated || left.publishedAt)
          || compareDate(right.publishedAt, left.publishedAt)
          || compareText(left.title, right.title);
      }
      if (sortKey === 'date-desc') {
        return compareDate(right.publishedAt, left.publishedAt)
          || compareDate(right.updated, left.updated)
          || compareText(left.title, right.title);
      }
      return compareText(left.title, right.title);
    }
    function uniqueArticleValues(field, predicate = () => true) {
      return [...new Set(articles.filter(predicate).map((article) => String(article[field] || '').trim()).filter(Boolean))]
        .sort((left, right) => compareText(left, right));
    }
    function populateFilterSelect(id, emptyLabel, values, { value } = {}) {
      const select = $(id);
      const current = value ?? select.value;
      select.innerHTML = '';
      const emptyOption = document.createElement('option');
      emptyOption.value = '';
      emptyOption.textContent = emptyLabel;
      select.append(emptyOption);
      values.forEach((optionValue) => {
        const option = document.createElement('option');
        option.value = optionValue;
        option.textContent = optionValue;
        select.append(option);
      });
      select.value = values.includes(current) ? current : '';
      syncCustomSelect(id);
    }
    function refreshFilterOptions() {
      const currentCategory = $('filter-category').value;
      const categoryValues = uniqueArticleValues('category');
      const category = categoryValues.includes(currentCategory) ? currentCategory : '';
      populateFilterSelect('filter-category', '全部分类', categoryValues, { value: category });

      const currentSubcategory = $('filter-subcategory').value;
      const subcategoryValues = uniqueArticleValues('subcategory', (article) => !category || article.category === category);
      populateFilterSelect('filter-subcategory', category ? '全部二级主题' : '全部分类下的主题', subcategoryValues, { value: currentSubcategory });
    }
    function updateFilterBadge() {
      const count = ['filter-category', 'filter-subcategory', 'filter-draft'].filter((id) => $(id).value).length;
      $('filter-badge').hidden = count === 0;
      $('filter-badge').textContent = String(count);
      $('filter-toggle').classList.toggle('active', count > 0);
    }
    async function loadList() {
      try {
        const res = await fetch('/admin/api/articles');
        const data = await res.json();
        articles = data.articles || [];
        $('article-count').textContent = `共 ${articles.length} 篇文章`;
        refreshFilterOptions();
        updateFilterBadge();
        renderList();
      } catch (error) {
        $('article-count').textContent = '读取失败';
        $('list').innerHTML = '<p class="count">文章列表暂时无法读取</p>';
      }
    }
    function renderList() {
      const query = $('filter').value.trim().toLocaleLowerCase('zh-CN');
      const category = $('filter-category').value;
      const subcategory = $('filter-subcategory').value;
      const draftFilter = $('filter-draft').value;
      const visibleArticles = articles
        .filter((article) => !query || String(article.title || '').toLocaleLowerCase('zh-CN').includes(query))
        .filter((article) => !category || article.category === category)
        .filter((article) => !subcategory || article.subcategory === subcategory)
        .filter((article) => !draftFilter || (draftFilter === 'draft' ? article.draft === true : article.draft !== true))
        .sort(compareArticles);
      $('list').innerHTML = visibleArticles.map((article) => {
        const meta = [article.category, article.subcategory].filter(Boolean).join(' · ');
        const draftBadge = article.draft === true ? '<span class="draft-badge">草稿</span>' : '';
        const active = article.path === selectedPath ? ' active' : '';
        return `<button class="article${active}" data-path="${encodeURIComponent(article.path)}" aria-pressed="${article.path === selectedPath}"><strong>${escapeHtml(article.title)}</strong><small>${escapeHtml(article.path)}</small><span class="article-meta"><span>${escapeHtml(meta || '未分类')}</span><span>${escapeHtml(article.publishedAt || '未设置日期')}</span>${draftBadge}</span></button>`;
      }).join('') || '<p class="count">暂无匹配文章</p>';
      document.querySelectorAll('.article').forEach((button) => { button.onclick = () => loadArticle(decodeURIComponent(button.dataset.path)); });
    }

    async function flushAutoSave() {
      while (isDirty) {
        const saved = await saveArticle();
        if (!saved) return false;
      }
      return true;
    }

    async function ensureEditorSaved() {
      if (!isDirty) return true;
      if (await flushAutoSave()) return true;
      return window.confirm('自动保存失败，仍要切换吗？');
    }

    async function loadArticle(articlePath) {
      if (!(await ensureEditorSaved())) return;
      try {
        const res = await fetch('/admin/api/article?path=' + encodeURIComponent(articlePath));
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '读取失败');
        selectedPath = articlePath;
        fill({ body: data.body, ...data.frontmatter });
        renderList();
        setStatus('已读取', 'neutral');
      } catch (error) { setStatus(error.message, 'error'); }
    }
    async function saveArticle({ force = false } = {}) {
      if (savePromise) return savePromise;
      if (!isDirty && !force) return true;
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = 0;
      rememberEditorSession();
      const path = editorArticlePath();
      const previousPath = selectedPath;
      const frontmatter = collectFrontmatter();
      const body = $('body').value;
      const currentDraftVersion = draftVersion;
      $('save').disabled = true;
      setStatus('自动保存中…', 'saving');
      const promise = (async () => {
        try {
          const res = await fetch('/admin/api/article', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ path, previousPath, frontmatter, body }) });
          const data = await res.json();
          if (!res.ok) throw new Error((data.errors || [data.error]).join('；'));
          const isCurrentDraft = draftVersion === currentDraftVersion;
          if (isCurrentDraft) {
            selectedPath = data.path;
            isDirty = false;
            if (data.frontmatter?.updated) $('updated').value = data.frontmatter.updated;
            clearEditorDraft();
            updateDeleteButton();
            setStatus('已自动保存 · 刚刚', 'saved');
          }
          await loadList();
          if (!isCurrentDraft) {
            setStatus('等待自动保存', 'saving');
            scheduleAutoSave();
          }
          return true;
        } catch (error) {
          setStatus(error.message, 'error');
          return false;
        } finally { $('save').disabled = false; }
      })();
      savePromise = promise;
      try { return await promise; }
      finally { if (savePromise === promise) savePromise = null; }
    }
    $('save').onclick = () => { void saveArticle({ force: true }); };
    $('delete').onclick = openDeleteModal;
    $('delete-modal-close').onclick = () => closeDeleteModal();
    $('delete-modal-cancel').onclick = () => closeDeleteModal();
    $('delete-modal-confirm').onclick = () => { void deleteCurrentArticle(); };
    $('delete-modal').onclick = (event) => { if (!deletePromise && (event.target === event.currentTarget || (event.target instanceof Element && event.target.matches('[data-delete-close]')))) closeDeleteModal(); };
    $('immersive-toggle').onclick = () => setImmersiveMode(!document.body.classList.contains('is-immersive'));
    $('new').onclick = async () => {
      if (!(await ensureEditorSaved())) return;
      selectedPath = '';
      fill();
      renderList();
      setStatus('新建模式', 'neutral');
      $('title').focus();
    };
    $('refresh').onclick = loadList;
    $('filter').oninput = renderList;
    document.querySelectorAll('.sort-option').forEach((button) => {
      button.onclick = () => {
        sortKey = button.dataset.sort;
        document.querySelectorAll('.sort-option').forEach((option) => {
          const selected = option === button;
          option.classList.toggle('on', selected);
          option.setAttribute('aria-checked', String(selected));
        });
        $('sort-toggle').title = `当前排序：${sortLabels[sortKey]}`;
        renderList();
        closeLibraryMenus();
      };
    });
    $('filter-category').onchange = () => {
      $('filter-subcategory').value = '';
      refreshFilterOptions();
      updateFilterBadge();
      renderList();
    };
    $('filter-subcategory').onchange = () => {
      updateFilterBadge();
      renderList();
    };
    $('filter-draft').onchange = () => {
      updateFilterBadge();
      renderList();
    };
    $('category').onchange = () => { refreshEditorSubcategories(); markDirty(); };
    $('subcategory').onchange = markDirty;
    $('clear-library-filters').onclick = () => {
      $('filter-category').value = '';
      refreshFilterOptions();
      updateFilterBadge();
      renderList();
    };
    const libraryMenus = [
      { trigger: $('sort-toggle'), menu: $('sort-menu') },
    ];
    function closeLibraryMenus() {
      libraryMenus.forEach(({ trigger, menu }) => {
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      });
    }
    libraryMenus.forEach(({ trigger, menu }) => {
      trigger.onclick = (event) => {
        event.stopPropagation();
        const shouldOpen = menu.hidden;
        closeLibraryMenus();
        menu.hidden = !shouldOpen;
        trigger.setAttribute('aria-expanded', String(shouldOpen));
      };
      menu.onclick = (event) => event.stopPropagation();
    });
    function closeFilterModal() {
      closeCustomSelects();
      $('filter-menu').hidden = true;
      $('filter-backdrop').hidden = true;
      $('filter-toggle').setAttribute('aria-expanded', 'false');
    }
    function openFilterModal() {
      closeLibraryMenus();
      $('filter-menu').hidden = false;
      $('filter-backdrop').hidden = false;
      $('filter-toggle').setAttribute('aria-expanded', 'true');
      customSelectRoot('filter-category')?.querySelector('.custom-select-trigger')?.focus();
    }
    $('filter-toggle').onclick = openFilterModal;
    $('filter-close').onclick = closeFilterModal;
    $('filter-done').onclick = closeFilterModal;
    $('filter-backdrop').onclick = closeFilterModal;
    document.addEventListener('click', closeLibraryMenus);
    document.addEventListener('click', () => closeCustomSelects());
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (closeEscapeLayers()) return;
      if (document.body.classList.contains('is-immersive')) {
        event.preventDefault();
        setImmersiveMode(false);
      }
    });
    document.querySelectorAll('.editor-tool').forEach((button) => { button.onclick = () => applyToolbarAction(button.dataset.action); });
    $('sync-to-preview').onclick = syncSourceToPreview;
    $('sync-to-source').onclick = syncPreviewToSource;
    $('preview').addEventListener('click', (event) => {
      const block = findPreviewBlock(event.target);
      if (block) {
        selectedPreviewNode = block;
        if (window.getSelection()?.isCollapsed !== false) selectedPreviewSourceRange = null;
      }
    });
    $('preview').addEventListener('mouseup', capturePreviewSelection);
    document.addEventListener('selectionchange', capturePreviewSelection);
    fields.forEach((field) => {
      const element = $(field);
      if (!element) return;
      element.addEventListener('input', markDirty);
      if (element.matches('select')) element.addEventListener('change', markDirty);
    });
    $('title').addEventListener('input', updateFileLabel);
    $('body').oninput = handleBodyInput;
    $('body').addEventListener('keydown', handleBodyKeydown);
    function scrollBodyToEdge(edge) {
      const body = $('body');
      body.focus({ preventScroll: true });
      body.scrollTo({ top: edge === 'top' ? 0 : body.scrollHeight, behavior: 'smooth' });
    }
    $('scroll-to-top').onclick = () => scrollBodyToEdge('top');
    $('scroll-to-bottom').onclick = () => scrollBodyToEdge('bottom');
    document.addEventListener('keydown', handleHistoryShortcut);
    window.addEventListener('pagehide', () => { rememberEditorSession(); rememberEditorDraft(); });
    ['click', 'keyup', 'select'].forEach((eventName) => { $('body').addEventListener(eventName, updateEditorMeta); });
    initializeCustomSelects();
    fill();
    setImmersiveMode(readImmersiveSession(), { focus: false, persist: false });
    const savedSession = readEditorSession();
    loadList().then(async () => {
      const savedDraft = readEditorDraft();
      if (restoreEditorDraft(savedDraft)) {
        restoreEditorPosition(savedDraft);
        return;
      }
      const savedArticle = savedSession?.selectedPath && articles.find((article) => article.path === savedSession.selectedPath);
      if (!savedArticle) return;
      await loadArticle(savedArticle.path);
      restoreEditorPosition(savedSession);
    });
  </script>
